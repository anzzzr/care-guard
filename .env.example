# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=careguard
POSTGRES_PASSWORD=careguard
POSTGRES_DB=careguard
DATABASE_URL=postgresql://careguard:careguard@localhost:5432/careguard
# Used by pytest; the database is created automatically if missing.
TEST_DATABASE_URL=postgresql://careguard:careguard@localhost:5432/careguard_test
# Free key from Google AI Studio. Pick a current model name there (e.g. a "flash" model).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Retrieval gate: below this best-chunk score the LLM is not called.
MIN_SCORE=0.37
# Required for /admin/* endpoints. Empty = admin endpoints refuse everyone.
ADMIN_API_KEY=change-me
